    <script>
        // App State
        let currentUser = null;
        let isSignupMode = true;
        let posts = JSON.parse(localStorage.getItem('bufferPosts') || '[]');
        let currentTab = 'overview';
        let uploadedFiles = [];
        let connectedAccounts = JSON.parse(localStorage.getItem('connectedAccounts') || '{}');

        // DOM Elements
        const landingPage = document.getElementById('landingPage');
        const dashboard = document.getElementById('dashboard');
        const authModal = document.getElementById('authModal');
        const authForm = document.getElementById('authForm');
        const authTitle = document.getElementById('authTitle');
        const authSubmit = document.getElementById('authSubmit');
        const authToggle = document.getElementById('authToggle');
        const nameField = document.getElementById('nameField');

        // Initialize app
        document.addEventListener('DOMContentLoaded', function() {
            // Check if user is logged in
            const savedUser = localStorage.getItem('bufferUser');
            if (savedUser) {
                currentUser = JSON.parse(savedUser);
                showDashboard();
            }

            // Set default date/time for post scheduler
            const now = new Date();
            const tomorrow = new Date(now.getTime() + 24 * 60 * 60 * 1000);
            document.getElementById('scheduleDate').value = tomorrow.toISOString().split('T')[0];
            document.getElementById('scheduleTime').value = '09:00';

            // Initialize media upload
            initializeMediaUpload();
            
            // Initialize account connections
            initializeAccountConnections();

            // Initialize charts if on analytics tab
            if (currentTab === 'analytics') {
                initializeCharts();
            }
        });

        // Media Upload Functions
        function initializeMediaUpload() {
            const dropZone = document.getElementById('dropZone');
            const fileInput = document.getElementById('mediaUpload');
            const preview = document.getElementById('mediaPreview');

            // Click to upload
            dropZone.addEventListener('click', () => fileInput.click());

            // Drag and drop
            dropZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                dropZone.classList.add('drag-over');
            });

            dropZone.addEventListener('dragleave', () => {
                dropZone.classList.remove('drag-over');
            });

            dropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropZone.classList.remove('drag-over');
                handleFiles(e.dataTransfer.files);
            });

            // File input change
            fileInput.addEventListener('change', (e) => {
                handleFiles(e.target.files);
            });
        }

        function handleFiles(files) {
            const preview = document.getElementById('mediaPreview');
            
            Array.from(files).forEach(file => {
                if (file.size > 300 * 1024 * 1024) {
                    alert(`File ${file.name} is too large. Maximum size is 300MB.`);
                    return;
                }

                const fileObj = {
                    id: Date.now() + Math.random(),
                    file: file,
                    name: file.name,
                    type: file.type,
                    size: file.size,
                    url: URL.createObjectURL(file)
                };

                uploadedFiles.push(fileObj);
                addFilePreview(fileObj);
            });

            if (uploadedFiles.length > 0) {
                preview.classList.remove('hidden');
            }
        }

        function addFilePreview(fileObj) {
            const preview = document.getElementById('mediaPreview');
            const div = document.createElement('div');
            div.className = 'relative group';
            div.dataset.fileId = fileObj.id;

            if (fileObj.type.startsWith('image/')) {
                div.innerHTML = `
                    <img src="${fileObj.url}" alt="${fileObj.name}" class="w-full h-24 object-cover rounded-lg">
                    <button onclick="removeFile(${fileObj.id})" class="absolute top-1 right-1 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center text-xs opacity-0 group-hover:opacity-100 transition-opacity">
                        ×
                    </button>
                    <p class="text-xs text-gray-500 mt-1 truncate">${fileObj.name}</p>
                `;
            } else if (fileObj.type.startsWith('video/')) {
                div.innerHTML = `
                    <video src="${fileObj.url}" class="w-full h-24 object-cover rounded-lg" controls></video>
                    <button onclick="removeFile(${fileObj.id})" class="absolute top-1 right-1 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center text-xs opacity-0 group-hover:opacity-100 transition-opacity">
                        ×
                    </button>
                    <p class="text-xs text-gray-500 mt-1 truncate">${fileObj.name}</p>
                `;
            }

            preview.appendChild(div);
        }

        function removeFile(fileId) {
            uploadedFiles = uploadedFiles.filter(f => f.id !== fileId);
            const element = document.querySelector(`[data-file-id="${fileId}"]`);
            if (element) {
                element.remove();
            }

            if (uploadedFiles.length === 0) {
                document.getElementById('mediaPreview').classList.add('hidden');
            }
        }

        // Account Connection Functions
        function initializeAccountConnections() {
            const platforms = ['twitter', 'facebook', 'instagram', 'linkedin', 'youtube', 'tiktok'];
            
            platforms.forEach(platform => {
                const connectBtn = document.getElementById(`connect${platform.charAt(0).toUpperCase() + platform.slice(1)}`);
                const status = document.getElementById(`${platform}Status`);
                const details = document.getElementById(`${platform}Details`);
                
                if (connectedAccounts[platform]) {
                    status.textContent = 'Connected';
                    status.classList.add('text-green-600');
                    connectBtn.textContent = 'Disconnect';
                    connectBtn.classList.remove('bg-blue-500', 'hover:bg-blue-600', 'bg-blue-600', 'hover:bg-blue-700', 'bg-pink-600', 'hover:bg-pink-700', 'bg-blue-700', 'hover:bg-blue-800', 'bg-red-600', 'hover:bg-red-700', 'bg-black', 'hover:bg-gray-800');
                    connectBtn.classList.add('bg-red-500', 'hover:bg-red-600');
                    if (details) details.classList.remove('hidden');
                }
                
                connectBtn.addEventListener('click', () => toggleConnection(platform));
            });
        }

        function toggleConnection(platform) {
            const connectBtn = document.getElementById(`connect${platform.charAt(0).toUpperCase() + platform.slice(1)}`);
            const status = document.getElementById(`${platform}Status`);
            const details = document.getElementById(`${platform}Details`);
            
            if (connectedAccounts[platform]) {
                // Disconnect
                delete connectedAccounts[platform];
                status.textContent = 'Not connected';
                status.classList.remove('text-green-600');
                connectBtn.textContent = 'Connect';
                connectBtn.classList.remove('bg-red-500', 'hover:bg-red-600');
                
                // Restore original button colors
                const colorMap = {
                    twitter: ['bg-blue-500', 'hover:bg-blue-600'],
                    facebook: ['bg-blue-600', 'hover:bg-blue-700'],
                    instagram: ['bg-pink-600', 'hover:bg-pink-700'],
                    linkedin: ['bg-blue-700', 'hover:bg-blue-800'],
                    youtube: ['bg-red-600', 'hover:bg-red-700'],
                    tiktok: ['bg-black', 'hover:bg-gray-800']
                };
                connectBtn.classList.add(...colorMap[platform]);
                
                if (details) details.classList.add('hidden');
                
                alert(`${platform.charAt(0).toUpperCase() + platform.slice(1)} account disconnected successfully!`);
            } else {
                // Connect (simulate API connection)
                connectedAccounts[platform] = {
                    connected: true,
                    connectedAt: new Date().toISOString()
                };
                
                status.textContent = 'Connected';
                status.classList.add('text-green-600');
                connectBtn.textContent = 'Disconnect';
                connectBtn.classList.remove('bg-blue-500', 'hover:bg-blue-600', 'bg-blue-600', 'hover:bg-blue-700', 'bg-pink-600', 'hover:bg-pink-700', 'bg-blue-700', 'hover:bg-blue-800', 'bg-red-600', 'hover:bg-red-700', 'bg-black', 'hover:bg-gray-800');
                connectBtn.classList.add('bg-red-500', 'hover:bg-red-600');
                
                if (details) details.classList.remove('hidden');
                
                alert(`${platform.charAt(0).toUpperCase() + platform.slice(1)} account connected successfully! In a real app, this would redirect to ${platform}'s OAuth flow.`);
            }
            
            localStorage.setItem('connectedAccounts', JSON.stringify(connectedAccounts));
        }

        // Auth Modal Functions
        function showAuthModal(mode = 'signup') {
            isSignupMode = mode === 'signup';
            authModal.classList.remove('hidden');
            updateAuthModal();
        }

        function hideAuthModal() {
            authModal.classList.add('hidden');
        }

        function updateAuthModal() {
            if (isSignupMode) {
                authTitle.textContent = 'Welcome to Zeyo Share';
                authSubmit.textContent = 'Sign Up';
                authToggle.textContent = 'Already have an account? Log in';
                nameField.classList.remove('hidden');
                document.getElementById('authName').required = true;
            } else {
                authTitle.textContent = 'Welcome Back';
                authSubmit.textContent = 'Log In';
                authToggle.textContent = "Don't have an account? Sign up";
                nameField.classList.add('hidden');
                document.getElementById('authName').required = false;
            }
        }

        // Event Listeners
        document.getElementById('loginBtn').addEventListener('click', () => showAuthModal('login'));
        document.getElementById('signupBtn').addEventListener('click', () => showAuthModal('signup'));
        document.getElementById('heroSignupBtn').addEventListener('click', () => showAuthModal('signup'));
        document.querySelectorAll('.signup-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const plan = e.target.dataset.plan;
                showAuthModal('signup');
                localStorage.setItem('selectedPlan', plan);
            });

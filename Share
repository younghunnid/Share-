            const samplePosts = [
                {
                    id: Date.now() - 3000,
                    content: "Just launched our new social media strategy! Excited to see the results 🚀 #socialmedia #marketing",
                    networks: ['twitter', 'linkedin'],
                    status: 'published',
                    publishedAt: new Date(Date.now() - 2 * 24 * 60 * 60 * 1000).toISOString(),
                    createdAt: new Date(Date.now() - 2 * 24 * 60 * 60 * 1000).toISOString(),
                    media: []

                {
                    id: Date.now() - 2000,
                    content: "Behind the scenes of our content creation process. What tools do you use for social media management?",
                    networks: ['facebook', 'instagram'],
                    status: 'published',
                    publishedAt: new Date(Date.now() - 1 * 24 * 60 * 60 * 1000).toISOString(),
